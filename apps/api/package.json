{
  "name": "@obsidian/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --incremental false",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:push": "prisma db push --accept-data-loss",
    "bootstrap": "tsx src/cli/bootstrap.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/csrf-protection": "^6.4.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/static": "6.12.0",
    "@nestjs/common": "10.4.7",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.7",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-fastify": "10.4.7",
    "@nestjs/schedule": "4.1.1",
    "@nestjs/swagger": "8.0.7",
    "@nestjs/throttler": "6.2.1",
    "@obsidian/contracts": "workspace:*",
    "@obsidian/permissions": "workspace:*",
    "@obsidian/wings-adapter": "workspace:*",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "bullmq": "5.25.6",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "crypto-random-string": "5.0.0",
    "fastify": "4.28.1",
    "helmet": "8.0.0",
    "ioredis": "5.4.1",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "^10.1.1",
    "otpauth": "9.3.5",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "yaml": "2.6.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.8",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.7",
    "@types/cookie-parser": "1.4.7",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "22.8.7",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "1.5.5",
    "prisma": "5.22.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
